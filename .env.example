# Copy to .env. Never commit .env.

# --- Django ---
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example
DJANGO_ADMIN_URL=admin/            # use something non-obvious in production, e.g. studio-7f3a/
# Local development without Docker:
# DJANGO_DEBUG=true
# DATABASE_URL=postgres://sinajokar:devpassword@127.0.0.1:5434/sinajokar

# --- PostgreSQL (docker-compose) ---
POSTGRES_DB=sinajokar
POSTGRES_USER=sinajokar
POSTGRES_PASSWORD=change-me

# --- Email notifications for new inquiries ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.mail.yahoo.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=               # an app password, not the account password
DEFAULT_FROM_EMAIL=website@your-domain.example
INQUIRY_NOTIFY_EMAIL=cnajokar11@yahoo.com

# --- API limits ---
API_THROTTLE_INQUIRIES=5/hour
API_NUM_PROXIES=1                  # proxies in front of Django (Next.js rewrite = 1; add 1 per extra reverse proxy)

# --- Frontend ---
NEXT_PUBLIC_SITE_URL=https://your-domain.example
API_INTERNAL_URL=http://127.0.0.1:8000
NEXT_PUBLIC_GTM_ID=                # empty = analytics fully disabled
